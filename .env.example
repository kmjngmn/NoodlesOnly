# 호스팅 환경변수에 설정하세요. 이 파일을 앱이 자동으로 읽지는 않습니다.
# 공개 HTTPS 환경에서만 1 (로컬 HTTP 개발에서는 0)
COOKIE_SECURE=0
# 배포 시 영구 디스크 경로로 변경
# DATA_DIR=/data/study
# 선택 사항: 비밀번호/키는 비밀 환경변수로 설정
# ADMIN_PASSWORD=
# STUDY_VISION_API_KEY=
# STUDY_VISION_MODEL=gpt-4.1-mini
# Vercel: 다음 값은 Vercel 프로젝트의 비밀 환경변수로 관리합니다.
# DATABASE_URL= (Supabase의 transaction pooler 연결 URL, 포트6543)
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# APP_SESSION_SECRET= (32자 이상의 임의 값)
# ADMIN_PASSWORD= (운영자가 정한 비밀번호)
# CRON_SECRET= (32자 이상의 임의 값)
